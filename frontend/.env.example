# Copia este archivo como .env.local y ajusta los valores.

# true  = el front funciona solo, con un LLM simulado y almacenamiento en el navegador.
# false = usa el backend FastAPI real (que a su vez habla con el LLM y con S3).
VITE_USE_MOCK=true

# Prefijo de la API. Con el proxy de Vite basta con /api.
# En producción puede ser una URL completa, p. ej. https://api.midominio.com/api
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo (solo lo usa vite.config.ts).
BACKEND_URL=http://localhost:8000
