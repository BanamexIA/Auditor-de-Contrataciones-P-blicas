# Copia este archivo como .env.local y ajusta los valores.

# Backend Flask al que Vite redirige /api (solo lo usa vite.config.ts).
#   Local: http://localhost:5000
#   EC2:   http://localhost:15000  (abre antes el túnel SSH, ver README)
BACKEND_URL=http://localhost:5000

# Prefijo de la API en el navegador. Con el proxy de Vite basta con /api.
VITE_API_BASE_URL=/api
