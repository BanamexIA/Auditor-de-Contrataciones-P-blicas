# Local development values only. Replace passwords before sharing or deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=auditor_contrataciones
DB_PORT_HOST=5432

# Least-privilege database roles
ETL_USER=etl_user
ETL_USER_PASSWORD=change-this-etl-password
AGENT_RO_USER=agent_ro
AGENT_RO_PASSWORD=change-this-agent-password

# Used by the backend container
DB_HOST=db
DB_PORT=5432
DB_NAME=auditor_contrataciones
DB_USER=etl_user
DB_PASSWORD=change-this-etl-password

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT_HOST=11435
BACKEND_PORT_HOST=5000
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_EMBED_BASE_URL=http://localhost:11435
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
