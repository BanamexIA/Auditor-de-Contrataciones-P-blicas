# Local development values only. Replace passwords before sharing or deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=auditor_contrataciones
DB_PORT_HOST=5432

# Least-privilege database roles
ETL_USER=etl_user
ETL_USER_PASSWORD=change-this-etl-password
AGENT_RO_USER=agent_ro
AGENT_RO_PASSWORD=change-this-agent-password

# Used by the backend container
DB_HOST=db
DB_PORT=5432
DB_NAME=auditor_contrataciones
DB_USER=etl_user
DB_PASSWORD=change-this-etl-password

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT_HOST=11435
BACKEND_PORT_HOST=5000
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Phase 6: model client used by the backend
AGENT_BASE_URL=http://host.docker.internal:11434
AGENT_MODEL=qwen2.5:7b

# OpenAI-compatible cloud endpoint, only for benchmark comparison
CLOUD_BASE_URL=https://api.openai.com/v1/chat/completions
CLOUD_MODEL=
CLOUD_API_KEY=
# Set these using the current prices for CLOUD_MODEL, in USD per 1 million tokens.
CLOUD_INPUT_USD_PER_1M_TOKENS=
CLOUD_OUTPUT_USD_PER_1M_TOKENS=
# Optional explicit local model list, comma-separated; otherwise detected from Ollama.
BENCHMARK_OLLAMA_MODELS=
